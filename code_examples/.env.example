# ============================================
# CRM PLATFORM - ENVIRONMENT CONFIGURATION
# ============================================

# ============================================
# SERVER & APPLICATION
# ============================================
NODE_ENV=development
PORT=3000
HOST=localhost
BASE_URL=http://localhost:3000
API_VERSION=v1

# ============================================
# DATABASE
# ============================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=crm_db
DATABASE_USER=crm_app_user
DATABASE_PASSWORD=secure_password_here
DATABASE_URL=postgresql://crm_app_user:secure_password_here@localhost:5432/crm_db
DATABASE_POOL_SIZE=10
DATABASE_POOL_IDLE_TIMEOUT=30000
DATABASE_CONNECTION_TIMEOUT=10000
DATABASE_DEBUG=false

# ============================================
# AUTHENTICATION & JWT
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=86400
JWT_ALGORITHM=HS256

# OAuth 2.0 Credentials
OAUTH_GOOGLE_CLIENT_ID=your_google_client_id
OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret
OAUTH_GITHUB_CLIENT_ID=your_github_client_id
OAUTH_GITHUB_CLIENT_SECRET=your_github_client_secret

# ============================================
# REDIS CACHE
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# ============================================
# MESSAGE QUEUE (RabbitMQ)
# ============================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ============================================
# EMAIL CONFIGURATION
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_EMAIL=noreply@crm-platform.com
SMTP_FROM_NAME="CRM Platform"
SMTP_SECURE=true

# Alternative: SendGrid
SENDGRID_API_KEY=SG.your_sendgrid_key
SENDGRID_FROM_EMAIL=noreply@crm-platform.com

# Alternative: Mailgun
MAILGUN_API_KEY=your_mailgun_key
MAILGUN_DOMAIN=mail.crm-platform.com

# ============================================
# SMS & NOTIFICATIONS
# ============================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# FILE STORAGE (AWS S3 Compatible)
# ============================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_S3_BUCKET=crm-platform-files
AWS_S3_ENDPOINT=https://s3.amazonaws.com
AWS_S3_FORCE_PATH_STYLE=false

# Alternative: MinIO (Self-hosted S3)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=crm-platform

# ============================================
# STRIPE PAYMENT
# ============================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ============================================
# PAYPAL
# ============================================
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# ============================================
# THIRD-PARTY INTEGRATIONS
# ============================================

# Mailchimp
MAILCHIMP_API_KEY=your_mailchimp_api_key
MAILCHIMP_SERVER_PREFIX=us1

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your_signing_secret

# Microsoft Teams
TEAMS_WEBHOOK_URL=https://outlook.webhook.office.com/...

# Zapier
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/...

# HubSpot
HUBSPOT_API_KEY=your_hubspot_api_key

# Salesforce
SALESFORCE_CLIENT_ID=your_salesforce_client_id
SALESFORCE_CLIENT_SECRET=your_salesforce_client_secret
SALESFORCE_USERNAME=your_salesforce_username
SALESFORCE_PASSWORD=your_salesforce_password

# Google Drive
GOOGLE_DRIVE_CLIENT_ID=your_google_drive_client_id
GOOGLE_DRIVE_CLIENT_SECRET=your_google_drive_client_secret

# OneDrive / Microsoft Graph
MICROSOFT_GRAPH_CLIENT_ID=your_microsoft_client_id
MICROSOFT_GRAPH_CLIENT_SECRET=your_microsoft_client_secret

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=logs/app.log
LOG_MAX_FILE_SIZE=10m
LOG_MAX_FILES=7

# ============================================
# MONITORING & OBSERVABILITY
# ============================================

# Sentry
SENTRY_DSN=https://your_key@sentry.io/your_project_id
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Datadog
DATADOG_API_KEY=your_datadog_api_key
DATADOG_SITE=datadoghq.com

# New Relic
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key
NEW_RELIC_APP_NAME=CRM-Platform

# ============================================
# SECURITY
# ============================================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
HELMET_ENABLED=true

# Encryption Keys
ENCRYPTION_KEY=your_32_char_encryption_key_here
ENCRYPTION_ALGORITHM=aes-256-cbc

# ============================================
# FRONTEND
# ============================================
REACT_APP_API_URL=http://localhost:3000/api/v1
REACT_APP_ENV=development
REACT_APP_VERSION=1.0.0

# ============================================
# FEATURES & FLAGS
# ============================================
FEATURE_AI_RECOMMENDATIONS=false
FEATURE_ADVANCED_AUTOMATION=false
FEATURE_WHITE_LABEL=false
FEATURE_CUSTOM_BRANDING=false
FEATURE_API_MARKETPLACE=false

# ============================================
# ANALYTICS
# ============================================
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
MIXPANEL_TOKEN=your_mixpanel_token
AMPLITUDE_API_KEY=your_amplitude_api_key

# ============================================
# BACKUP & DISASTER RECOVERY
# ============================================
BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=crm-platform-backups

# ============================================
# DEVELOPMENT ONLY
# ============================================
DEBUG=false
MOCK_EXTERNAL_SERVICES=false
SEED_DATABASE=false
ALLOW_CORS_ALL=false
DISABLE_AUTH=false
